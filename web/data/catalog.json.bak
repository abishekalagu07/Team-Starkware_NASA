.webp"},{"date":"2026-07-26","url":"sites/mexico-city/frames/20260726.webp"},{"date":"2026-08-07","url":"sites/mexico-city/frames/20260807.webp"},{"date":"2026-08-19","url":"sites/mexico-city/frames/20260819.webp"},{"date":"2026-08-31","url":"sites/mexico-city/frames/20260831.webp"},{"date":"2026-09-12","url":"sites/mexico-city/frames/20260912.webp"},{"date":"2026-09-24","url":"sites/mexico-city/frames/20260924.webp"},{"date":"2026-10-06","url":"sites/mexico-city/frames/20261006.webp"},{"date":"2026-10-18","url":"sites/mexico-city/frames/20261018.webp"},{"date":"2026-10-30","url":"sites/mexico-city/frames/20261030.webp"}],"title":"Cumulative line-of-sight displacement"},"overlays":[{"id":"rate","name":"Annualised LOS rate","url":"sites/mexico-city/rate.webp","legend":{"type":"diverging","vmin":-33,"vmax":33,"unit":"cm/yr","neg":"#eb6834","pos":"#2a78d6","mid":"#d9d8d4","neg_label":"away (subsiding)","pos_label":"towards (uplift)"}}],"cube":"sites/mexico-city/cube.json"},"stats":[{"label":"Max subsidence (LOS)","value":-13.5,"unit":"cm","note":"over 132 days"},{"label":"Peak rate","value":-37.3,"unit":"cm/yr","note":"annualised"},{"label":"Area sinking > 1 cm/month","value":188,"unit":"km\u00b2"},{"label":"Interferograms chained","value":11,"unit":""}],"charts":[{"id":"cum","title":"Cumulative LOS displacement","unit":"cm","kind":"line","dates":["2026-06-20","2026-07-02","2026-07-14","2026-07-26","2026-08-07","2026-08-19","2026-08-31","2026-09-12","2026-09-24","2026-10-06","2026-10-18","2026-10-30"],"series":[{"name":"Fastest-sinking pixel","color":"#eb6834","values":[0.0,-1.7,-2.72,-4.2,-4.95,-6.81,-8.72,-10.02,-11.46,-11.85,-11.99,-13.5]},{"name":"Area median","color":"#8a8985","values":[0.0,-0.33,-0.33,-0.21,-0.03,-0.82,-1.33,-1.27,-1.16,-0.06,0.36,0.14]}]}],"date_range":["2026-06-20","2026-10-30"]},{"id":"punjab-paddy","name":"Kharif paddy belt, Punjab","region":"India","continent":"Asia","change_type":"crop","product":"GCOV","bbox":[75.6,30.2,76.3,30.75],"story":{"headline":"Watching a rice season breathe, field by field","what":"Paddies are flooded for transplanting (dark), the canopy grows (bright), then harvest and residue burning reset them.","physics":"Flooded paddy = specular water, very dark. As rice tillers grow, volume scattering raises HV by 5-10 dB within weeks. The V-shaped HV curve is the radar fingerprint of rice. S-band responds more to leaves, L-band to stems and the soil-water interface.","drivers":"Monsoon-timed transplanting, groundwater irrigation, procurement-driven rice monoculture, Aug-Sep 2026 floods that destroyed standing crops.","caveats":"Rain on bare soil also brightens HH; use HV and the temporal shape, not single dates."},"s_band":true,"window":["2026-06-17","2026-11-10"],"bounds":[75.6,30.2,76.3,30.75],"center":[75.94999999999999,30.475],"demo":true,"band":"L","layers":{"frames":{"kind":"rgb","legend":{"type":"rgb","items":[{"label":"HH: surface & double bounce","color":"#e34948"},{"label":"HV: volume (vegetation)","color":"#1baf7a"},{"label":"HH/HV ratio","color":"#2a78d6"}]},"items":[{"date":"2026-06-20","url":"sites/punjab-paddy/frames/20260620.webp"},{"date":"2026-07-02","url":"sites/punjab-paddy/frames/20260702.webp"},{"date":"2026-07-14","url":"sites/punjab-paddy/frames/20260714.webp"},{"date":"2026-07-26","url":"sites/punjab-paddy/frames/20260726.webp"},{"date":"2026-08-07","url":"sites/punjab-paddy/frames/20260807.webp"},{"date":"2026-08-19","url":"sites/punjab-paddy/frames/20260819.webp"},{"date":"2026-08-31","url":"sites/punjab-paddy/frames/20260831.webp"},{"date":"2026-09-12","url":"sites/punjab-paddy/frames/20260912.webp"},{"date":"2026-09-24","url":"sites/punjab-paddy/frames/20260924.webp"},{"date":"2026-10-06","url":"sites/punjab-paddy/frames/20261006.webp"},{"date":"2026-10-18","url":"sites/punjab-paddy/frames/20261018.webp"},{"date":"2026-10-30","url":"sites/punjab-paddy/frames/20261030.webp"}]},"overlays":[{"id":"change","name":"Crop type from radar phenology","default":true,"url":"sites/punjab-paddy/change.png","legend":{"type":"classes","items":[{"code":1,"label":"Paddy rice (flood-then-grow)","color":"#1baf7a"},{"code":2,"label":"Other active cropland","color":"#eda100"}]}},{"id":"peak","name":"Date of peak canopy (HV max)","url":"sites/punjab-paddy/peak_day.webp","legend":{"type":"sequential","vmin":0,"vmax":132.0,"unit":"days","start_date":"2026-06-20","ramp":["#cde2fb","#6da7ec","#2a78d6","#184f95","#0d366b"]}}],"cube":"sites/punjab-paddy/cube.json"},"stats":[{"label":"Paddy rice (flood-then-grow)","value":1695.43,"unit":"km\u00b2","note":"41.52% of area"},{"label":"Other active cropland","value":1790.97,"unit":"km\u00b2","note":"43.86% of area"},{"label":"Median HV dynamic range (rice)","value":17.0,"unit":"dB","note":"flood -> full canopy"}],"charts":[{"id":"backscatter","title":"Mean HV backscatter by class","unit":"dB","kind":"line","dates":["2026-06-20","2026-07-02","2026-07-14","2026-07-26","2026-08-07","2026-08-19","2026-08-31","2026-09-12","2026-09-24","2026-10-06","2026-10-18","2026-10-30"],"series":[{"name":"Stable / non-crop","values":[-11.680000305175781,-11.649999618530273,-11.649999618530273,-11.649999618530273,-11.640000343322754,-11.630000114440918,-11.619999885559082,-11.619999885559082,-11.619999885559082,-11.630000114440918,-11.609999656677246,-11.630000114440918],"color":"#8a8985"},{"name":"Paddy rice (flood-then-grow)","values":[-18.8799991607666,-19.84000015258789,-21.299999237060547,-19.940000534057617,-16.6200008392334,-13.850000381469727,-12.220000267028809,-11.34000015258789,-11.010000228881836,-10.930000305175781,-10.90999984741211,-12.449999809265137],"color":"#1baf7a"},{"name":"Other active cropland","values":[-18.40999984741211,-18.610000610351562,-18.6200008392334,-17.760000228881836,-16.229999542236328,-14.699999809265137,-13.710000038146973,-13.149999618530273,-12.9399995803833,-12.859999656677246,-12.850000381469727,-13.720000267028809],"color":"#eda100"}]}],"stack":{"track":0,"frame":0,"direction":"A","band":"L","n":12,"synthetic":true},"n_dates":12,"date_range":["2026-06-20","2026-10-30"]},{"id":"rowe-creek-fire","name":"Rowe Creek Complex fire, Oregon","region":"USA","continent":"North America","change_type":"disturbance","product":"GCOV","bbox":[-120.7,44.35,-119.8,44.95],"story":{"headline":"Record Oregon fire season: burn scars through the smoke","what":"Loss of forest and juniper canopy in a lightning-started complex of fires.","physics":"HV (cross-pol) comes from multiple scattering inside the canopy. Burning removes that volume, so HV drops 3-6 dB and stays low; HH may briefly rise from exposed, rough, wet soil.","drivers":"Low snowpack, drought, dry lightning, decades of fuel build-up.","caveats":"Grass/shrub fires (e.g. Big Grass Fire) barely change L-band HV: there is little volume to lose. That is a physics result, not a failure."},"event_date":"2026-07-20","window":["2026-06-17","2026-10-31"],"bounds":[-120.7,44.35,-119.8,44.95],"center":[-120.25,44.650000000000006],"demo":true,"band":"L","layers":{"frames":{"kind":"rgb","legend":{"type":"rgb","items":[{"label":"HH: surface & double bounce","color":"#e34948"},{"label":"HV: volume (vegetation)","color":"#1baf7a"},{"label":"HH/HV ratio","color":"#2a78d6"}]},"items":[{"date":"2026-06-20","url":"sites/rowe-creek-fire/frames/20260620.webp"},{"date":"2026-07-02","url":"sites/rowe-creek-fire/frames/20260702.webp"},{"date":"2026-07-14","url":"sites/rowe-creek-fire/frames/20260714.webp"},{"date":"2026-07-26","url":"sites/rowe-creek-fire/frames/20260726.webp"},{"date":"2026-08-07","url":"sites/rowe-creek-fire/frames/20260807.webp"},{"date":"2026-08-19","url":"sites/rowe-creek-fire/frames/20260819.webp"},{"date":"2026-08-31","url":"sites/rowe-creek-fire/frames/20260831.webp"},{"date":"2026-09-12","url":"sites/rowe-creek-fire/frames/20260912.webp"},{"date":"2026-09-24","url":"sites/rowe-creek-fire/frames/20260924.webp"},{"date":"2026-10-06","url":"sites/rowe-creek-fire/frames/20261006.webp"},{"date":"2026-10-18","url":"sites/rowe-creek-fire/frames/20261018.webp"},{"date":"2026-10-30","url":"sites/rowe-creek-fire/frames/20261030.webp"}]},"overlays":[{"id":"change","name":"Vegetation loss / gain (HV)","default":true,"url":"sites/rowe-creek-fire/change.png","legend":{"type":"classes","items":[{"code":1,"label":"Vegetation loss (burn / clearing)","color":"#e34948"},{"code":2,"label":"Vegetation gain / regrowth","color":"#008300"}]}},{"id":"ratio","name":"HV change after vs. before","url":"sites/rowe-creek-fire/ratio.webp","legend":{"type":"diverging","vmin":-6,"vmax":6,"unit":"dB","neg":"#eb6834","pos":"#2a78d6","mid":"#d9d8d4","neg_label":"canopy loss","pos_label":"gain"}}],"cube":"sites/rowe-creek-fire/cube.json"},"stats":[{"label":"Vegetation loss (burn / clearing)","value":1497.94,"unit":"km\u00b2","note":"31.69% of area"},{"label":"Vegetation gain / regrowth","value":23.12,"unit":"km\u00b2","note":"0.49% of area"},{"label":"Mean HV drop in loss area","value":-5.2,"unit":"dB","note":"volume scattering removed"}],"charts":[{"id":"backscatter","title":"Mean HV backscatter by class","unit":"dB","kind":"line","dates":["2026-06-20","2026-07-02","2026-07-14","2026-07-26","2026-08-07","2026-08-19","2026-08-31","2026-09-12","2026-09-24","2026-10-06","2026-10-18","2026-10-30"],"series":[{"name":"No change","values":[-13.960000038146973,-13.960000038146973,-13.9399995803833,-13.949999809265137,-13.970000267028809,-14.0,-13.960000038146973,-13.949999809265137,-13.949999809265137,-13.989999771118164,-13.970000267028809,-13.979999542236328],"color":"#8a8985"},{"name":"Vegetation loss (burn / clearing)","values":[-12.34000015258789,-12.319999694824219,-12.34000015258789,-12.989999771118164,-15.789999961853027,-17.709999084472656,-17.719999313354492,-17.700000762939453,-17.68000030517578,-17.700000762939453,-17.700000762939453,-17.700000762939453],"color":"#e34948"},{"name":"Vegetation gain / regrowth","values":[-13.649999618530273,-13.579999923706055,-13.670000076293945,-12.09000015258789,-11.979999542236328,-12.010000228881836,-11.890000343322754,-12.100000381469727,-11.949999809265137,-12.039999961853027,-11.970000267028809,-12.229999542236328],"color":"#008300"}]}],"stack":{"track":0,"frame":0,"direction":"A","band":"L","n":12,"synthetic":true},"n_dates":12,"date_range":["2026-06-20","2026-10-30"]},{"id":"sermeq-kujalleq","name":"Sermeq Kujalleq (Jakobshavn), Greenland","region":"Greenland","continent":"Arctic","change_type":"glacier","product":"GOFF","bbox":[-50.4,69.05,-48.8,69.3],"story":{"headline":"The world's fastest glacier, tracked every 12 days","what":"Ice surface speed from pixel offset tracking between repeat passes.","physics":"Phase interferometry fails on fast-flowing, melting ice (coherence is lost), so features are cross-correlated between images; L-band penetrates the snow surface and keeps texture through melt season.","drivers":"Warm Atlantic water melting the floating tongue, summer melt lubricating the bed, seasonal ice-melange buttressing.","caveats":"Offsets over 12 days near the calving front can exceed the search window; check the SNR layer."},"window":["2026-06-17","2026-11-10"],"bounds":[-50.4,69.05,-48.8,69.3],"center":[-49.599999999999994,69.175],"demo":true,"band":"L","layers":{"frames":{"kind":"sequential","items":[{"date":"2026-07-02","url":"sites/sermeq-kujalleq/frames/20260702.webp"},{"date":"2026-07-14","url":"sites/sermeq-kujalleq/frames/20260714.webp"},{"date":"2026-07-26","url":"sites/sermeq-kujalleq/frames/20260726.webp"},{"date":"2026-08-07","url":"sites/sermeq-kujalleq/frames/20260807.webp"},{"date":"2026-08-19","url":"sites/sermeq-kujalleq/frames/20260819.webp"},{"date":"2026-08-31","url":"sites/sermeq-kujalleq/frames/20260831.webp"},{"date":"2026-09-12","url":"sites/sermeq-kujalleq/frames/20260912.webp"},{"date":"2026-09-24","url":"sites/sermeq-kujalleq/frames/20260924.webp"},{"date":"2026-10-06","url":"sites/sermeq-kujalleq/frames/20261006.webp"},{"date":"2026-10-18","url":"sites/sermeq-kujalleq/frames/20261018.webp"},{"date":"2026-10-30","url":"sites/sermeq-kujalleq/frames/20261030.webp"}],"title":"Ice surface speed","legend":{"type":"sequential","vmin":0,"vmax":33.0,"unit":"m/day","ramp":["#cde2fb","#6da7ec","#2a78d6","#184f95","#0d366b"]}},"overlays":[],"cube":"sites/sermeq-kujalleq/cube.json"},"stats":[{"label":"Peak trunk speed","value":18.1,"unit":"m/day","note":"26 Jul"},{"label":"\u2248 per year","value":6.6,"unit":"km/yr"},{"label":"Seasonal speed change","value":27,"unit":"%"},{"label":"Offset pairs","value":11,"unit":""}],"charts":[{"id":"speed","title":"Ice speed through the melt season","unit":"m/day","kind":"line","dates":["2026-07-02","2026-07-14","2026-07-26","2026-08-07","2026-08-19","2026-08-31","2026-09-12","2026-09-24","2026-10-06","2026-10-18","2026-10-30"],"series":[{"name":"Fast trunk (top 10%)","color":"#2a78d6","values":[16.72,17.65,18.08,17.23,15.99,15.21,14.81,14.65,14.5,14.37,14.29]},{"name":"Whole area median","color":"#8a8985","values":[0.7,0.75,0.77,0.72,0.65,0.62,0.64,0.6,0.62,0.61,0.6]}]}],"date_range":["2026-06-20","2026-10-30"]},{"id":"sudd-wetland","name":"Sudd wetland, South Sudan","region":"South Sudan","continent":"Africa","change_type":"flood","product":"GCOV","bbox":[30.4,7.0,31.4,8.0],"story":{"headline":"Africa's largest wetland swells with the rains","what":"Seasonal expansion of open water and flooded papyrus swamp along the White Nile.","physics":"Flooded papyrus and grass produce strong HH double bounce at L-band - the swamp brightens as it floods, while open lagoons go dark.","drivers":"East African rains feeding Lake Victoria and the White Nile, record lake levels since 2019-2020.","caveats":"Floating vegetation mats move; very dense papyrus can saturate the signal."},"event_date":"2026-08-01","window":["2026-06-17","2026-11-10"],"bounds":[30.4,7.0,31.4,8.0],"center":[30.9,7.5],"demo":true,"band":"L","layers":{"frames":{"kind":"rgb","legend":{"type":"rgb","items":[{"label":"HH: surface & double bounce","co