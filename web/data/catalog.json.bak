0,"direction":"A","band":"L","n":12,"synthetic":true},"n_dates":12,"date_range":["2026-06-20","2026-10-30"]},{"id":"assam-brahmaputra","name":"Brahmaputra floodplain, Assam","region":"India","continent":"Asia","change_type":"flood","product":"GCOV","bbox":[93.6,26.55,94.7,27.15],"story":{"headline":"Assam's worst flood in six decades, seen through monsoon cloud","what":"Open floodwater spreading over farmland and villages along the Brahmaputra, then draining away.","physics":"Calm water mirrors the radar pulse away from the satellite, so HH backscatter collapses (black). Where water sits beneath crops or trees, L-band's 24 cm wave bounces water->stem->satellite and HH turns brighter: the flooded-vegetation class optical satellites and C-band radar mostly miss.","drivers":"Monsoon rain several times above normal in upper Assam, sediment-choked braided channels, embankment breaches, wetland loss and upstream deforestation.","caveats":"Wind-roughened water can look bright; very smooth sand bars can look like water. Compare against GPM rainfall and gauge data."},"event_date":"2026-07-15","s_band":true,"window":["2026-06-17","2026-10-31"],"bounds":[93.6,26.55,94.7,27.15],"center":[94.15,26.85],"demo":true,"band":"L","layers":{"frames":{"kind":"rgb","legend":{"type":"rgb","items":[{"label":"HH: surface & double bounce","color":"#e34948"},{"label":"HV: volume (vegetation)","color":"#1baf7a"},{"label":"HH/HV ratio","color":"#2a78d6"}]},"items":[{"date":"2026-06-20","url":"sites/assam-brahmaputra/frames/20260620.webp"},{"date":"2026-07-02","url":"sites/assam-brahmaputra/frames/20260702.webp"},{"date":"2026-07-14","url":"sites/assam-brahmaputra/frames/20260714.webp"},{"date":"2026-07-26","url":"sites/assam-brahmaputra/frames/20260726.webp"},{"date":"2026-08-07","url":"sites/assam-brahmaputra/frames/20260807.webp"},{"date":"2026-08-19","url":"sites/assam-brahmaputra/frames/20260819.webp"},{"date":"2026-08-31","url":"sites/assam-brahmaputra/frames/20260831.webp"},{"date":"2026-