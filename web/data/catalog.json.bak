 different patterns; combine them for east/up. L-band ionosphere near the equator can add cm-scale ramps - the GUNW ionospheric screen is subtracted."},"event_date":"2026-06-24T22:04:00","epicenters":[[-68.556,10.371],[-67.21,10.6]],"window":["2026-06-01","2026-08-15"],"bounds":[-69.0,9.95,-66.8,10.9],"center":[-67.9,10.425],"demo":true,"band":"L","layers":{"frames":{"kind":"static","items":[]},"overlays":[{"id":"fringes","name":"Interferogram fringes (rewrapped)","url":"sites/venezuela-doublet/fringes.webp","default":true,"legend":{"type":"cyclic","period_cm":11.9,"note":"one colour cycle = \u03bb/2 of line-of-sight motion"}},{"id":"disp","name":"Line-of-sight displacement","url":"sites/venezuela-doublet/displacement.webp","legend":{"type":"diverging","vmin":-42,"vmax":42,"unit":"cm","neg":"#eb6834","pos":"#2a78d6","mid":"#d9d8d4","neg_label":"away from satellite","pos_label":"towards satellite"}},{"id":"coh","name":"Interferometric coherence (data quality)","url":"sites/venezuela-doublet/coherence.webp","legend":{"type":"sequential","vmin":0,"vmax":1,"unit":"","ramp":["#cde2fb","#6da7ec","#2a78d6","#184f95","#0d366b"]}}],"cube":"sites/venezuela-doublet/cube.json"},"stats":[{"label":"Max motion towards satellite","value":43.4,"unit":"cm"},{"label":"Max motion away from satellite","value":-26.1,"unit":"cm"},{"label":"Area moved > 20 cm","value":14978,"unit":"km\u00b2","note":"line of sight"},{"label":"Pair","value":"20 Jun \u2192 02 Jul","unit":"","note":"12-day interferogram"}],"charts":[{"id":"pairs","title":"Ground motion per 12-day pair (95th pct |LOS|)","unit":"cm","kind":"bar","bars":[{"label":"08 Jun\u201320 Jun","value":1.44,"event":false},{"label":"20 Jun\u201302 Jul","value":41.36,"event":true},{"label":"02 Jul\u201314 Jul","value":1.41,"event":false},{"label":"14 Jul\u201326 Jul","value":1.39,"event":false},{"label":"26 Jul\u201307 Aug","value":1.44,"event":false}]}],"stack":{"track":0,"frame":0,"direction":"A","band":"L","n":5,"synthetic":true},"date_ran